#!/usr/bin/env bash
set -Eeuo pipefail

resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

ROOT="$(resolve_self)"
export PATH="$ROOT/bin:$PATH"
exec "$ROOT/bin/node" "$ROOT/dist/cli.js" "$@"
